    {
      "category": "Sandbox",
      "key": "Sandbox_AutoMechanics_ConditionLossPercentageThreshold_tooltip",
      "english": "Accepted risk percentage of losing part condition. <LINE> 0 (recommended for public servers) will protect your vehicles parts conditions. <LINE> 100 let players do whatever they want (recommended for private servers). <LINE> Only active on multiplayer clients or solo users with Verbose on.",
      "source_file": "Sandbox.json",
      "source_layer": "42.18",
      "source_format": "json",
      "translations": {
        "DE": {
          "text": "Akzeptiertes Risiko in Prozent, dass sich der Zustand eines Teils verschlechtert. <LINE> 0 (für öffentliche Server empfohlen) schützt den Zustand deiner Fahrzeugteile. <LINE> 100 lässt den Spielern freie Hand (für private Server empfohlen). <LINE> Nur für Mehrspieler-Clients oder im Einzelspielermodus mit aktivierter ausführlicher Protokollierung wirksam.",
          "needed": true,
          "review": false
        }
      }
    },
